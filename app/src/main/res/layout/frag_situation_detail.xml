<?xml version="1.0" encoding="utf-8"?>
<!-- Details of the selected situation, split into sections -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp">

        <!-- Icon + type -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">
            <ImageView
                android:id="@+id/detailIcon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="10dp"
                android:contentDescription="Situation type icon" />
            <TextView
                android:id="@+id/detailType"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/detailComment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="16sp" />

        <!-- Roadworks only: duration band in its colour -->
        <TextView
            android:id="@+id/detailDuration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/detailMapButton"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Show on the map" />

        <TextView
            style="@style/DetailHeading"
            android:text="When" />
        <TextView
            android:id="@+id/detailWhen"
            style="@style/DetailBody" />

        <TextView
            style="@style/DetailHeading"
            android:text="Impact" />
        <TextView
            android:id="@+id/detailImpact"
            style="@style/DetailBody" />

        <TextView
            style="@style/DetailHeading"
            android:text="Where" />
        <TextView
            android:id="@+id/detailWhere"
            style="@style/DetailBody" />

        <TextView
            style="@style/DetailHeading"
            android:text="Record" />
        <TextView
            android:id="@+id/detailRecord"
            style="@style/DetailBody" />
    </LinearLayout>
</ScrollView>
